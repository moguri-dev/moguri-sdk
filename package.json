{
  "name": "@moguri-dev/sdk",
  "version": "0.32.0-alpha.10",
  "license": "MIT",
  "description": "Shared APIs and integrations for building on Moguri: the typed SDK, the local control-plane service and its workers.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moguri-dev/moguri-sdk.git"
  },
  "homepage": "https://github.com/moguri-dev/moguri-sdk#readme",
  "bugs": {
    "url": "https://github.com/moguri-dev/moguri-sdk/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/types/packages/sdk/src/index.d.ts",
      "import": "./dist/sdk/index.mjs"
    },
    "./node": {
      "types": "./dist/types/packages/sdk/src/node.d.ts",
      "import": "./dist/sdk/node.mjs"
    },
    "./react": {
      "types": "./dist/types/packages/sdk/src/react.d.ts",
      "import": "./dist/sdk/react.mjs"
    },
    "./mcp": {
      "types": "./dist/types/packages/sdk/src/mcp-server.d.ts",
      "import": "./dist/sdk/mcp.mjs"
    },
    "./testing": {
      "types": "./dist/types/packages/sdk/src/testing.d.ts",
      "import": "./dist/testing.mjs"
    },
    "./remote-bridge": {
      "types": "./dist/types/apps/service/src/remote-bridge.d.ts",
      "import": "./dist/remote-bridge.mjs"
    },
    "./sandbox-distribution": "./scripts/prepare-sandbox-distribution.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "moguri-worker": "bin/moguri-worker.mjs"
  },
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/prepare-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit ${MOGURI_TEST_SHARD:+--test-shard=$MOGURI_TEST_SHARD} tests/*.test.ts",
    "test:latency": "node --import tsx --test --test-concurrency=1 --test-force-exit tests/latency-budgets.test.ts tests/service-issue-responsiveness.test.ts tests/issue-history-responsiveness.test.ts tests/event-read-indexes.test.ts tests/work-item-comments.test.ts tests/service-startup-discovery.test.ts tests/model-refresh.test.ts",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "check:prices": "node --import tsx scripts/check-price-freshness.ts",
    "spike:workspace": "node scripts/workspace-spikes.mjs",
    "spike:models": "node scripts/model-controls-spike.mjs",
    "spike:engagement": "node scripts/engagement-spikes.mjs",
    "spike:runtime": "node scripts/runtime-spikes.mjs",
    "qualify:ds4": "node scripts/qualify-ds4.mjs",
    "spike:remote": "node scripts/remote-spike.mjs",
    "spike:worktrees": "node scripts/worktree-spike.mjs",
    "spike:documents": "node --import tsx scripts/document-spike.mjs",
    "spike:otel": "node --import tsx scripts/otel-spike.ts",
    "spike:stainless": "node --import tsx scripts/stainless-spike.ts",
    "spike:otel-overhead": "node --import tsx scripts/otel-overhead.ts",
    "spike:virtual-disk": "node --import tsx scripts/virtual-disk-spike.ts",
    "spike:worker-image": "node scripts/prepare-worker-image.mjs --build",
    "prepare:sandbox": "npm run build && node scripts/prepare-sandbox-distribution.mjs",
    "service": "node --import tsx apps/service/src/main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/otlp-transformer": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "docx": "9.14.0",
    "fflate": "0.8.3",
    "ignore": "7.0.12",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "node-pty": "1.2.0-beta.18",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1",
    "pnpm": "12.14.0",
    "sax": "1.6.1",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "shell-quote": "1.12.0",
    "spdx-license-list": "6.12.0",
    "sqlite-vec": "0.1.9",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "write-excel-file": "4.1.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "react": ">=19.3.1 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "@playwright/test": "1.64.1",
    "@types/cacache": "20.0.1",
    "@types/react": "19.3.0",
    "@types/sax": "1.2.7",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "@vscode/debugprotocol": "1.68.0",
    "cacache": "21.0.1",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "node": "26.12.0",
    "react": "19.3.1",
    "tsx": "4.23.15"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "encoding-sniffer": "1.0.2",
    "node-fetch": "npm:node-fetch-native@1.6.7",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:./scripts/stubs/claude-agent-sdk-no-bundled-binary"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node@26.12.0": true,
    "node-pty@1.2.0-beta.18": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents": false,
    "pnpm@12.14.0": false
  },
  "files": [
    "bin",
    "dist",
    "scripts/prepare-native.mjs",
    "scripts/build-cache.mjs",
    "scripts/prepare-sandbox-distribution.mjs",
    "scripts/prepare-worker-image.mjs",
    "scripts/prepare-apple-init.mjs",
    "scripts/prepare-apple-init.d.mts",
    "scripts/worker-image",
    "docs/sdk.md",
    "docs/third-party.md",
    "docs/architecture"
  ]
}
