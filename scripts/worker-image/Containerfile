FROM docker.io/library/node@sha256:f6e55fb0e92f7f115549278ab36f68f0659790f5d4fd7cb4446486d8ed70d842

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nftables python3 make g++ \
    && rm -r /var/lib/apt/lists

WORKDIR /opt/moguri
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm rebuild node-pty --ignore-scripts=false --no-fund \
    && npm audit --audit-level=moderate

COPY dist ./dist
COPY --chmod=0444 payload.json ./payload.json
RUN node --input-type=module -e '\
    import { createHash } from "node:crypto"; \
    import { lstat, readFile, realpath } from "node:fs/promises"; \
    import pty from "node-pty"; \
    const payload = JSON.parse(await readFile("payload.json", "utf8")); \
    if (process.versions.node !== "26.12.0") throw new Error("Unexpected workload Node version"); \
    const entry = "/usr/local/bin/node"; \
    if (!(await lstat(entry)).isFile() || await realpath(entry) !== entry) throw new Error("SendBox entrypoint must be a regular canonical executable, never a symlink"); \
    for (const [path, expected] of Object.entries(payload.files)) { \
      const actual = createHash("sha256").update(await readFile(path)).digest("hex"); \
      if (actual !== expected) throw new Error("Workload payload digest mismatch"); \
    } \
    const child = pty.spawn("/bin/sh", ["-c", "printf GENERATED_LINUX_PTY_READY"], { cwd: "/tmp", env: { PATH: "/usr/bin:/bin" } }); \
    let output = ""; child.onData(data => { output += data; }); \
    const exit = await new Promise(resolve => child.onExit(resolve)); \
    if (exit.exitCode !== 0 || !output.includes("GENERATED_LINUX_PTY_READY")) throw new Error("Linux PTY primitive failed"); \
    console.log("GENERATED_LINUX_PAYLOAD_VERIFIED");' \
    && nft --version

RUN mkdir /workspace && chown node:node /workspace
USER node
WORKDIR /workspace
RUN node -e 'require("node:fs").accessSync("/opt/moguri/payload.json", require("node:fs").constants.R_OK)'
ENTRYPOINT ["/usr/local/bin/node", "/opt/moguri/dist/remote-bridge.mjs"]
